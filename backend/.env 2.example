# Copy to backend/.env and fill in. Never commit the real .env.

# MySQL connection string
DATABASE_URL="mysql://root:password@localhost:3306/notevault_db"

# Secret used to sign login tokens. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# How long a login lasts (e.g. 7d, 12h)
JWT_EXPIRES_IN="7d"

PORT=5069

# Public URL of the frontend. Used for links in emails and as the allowed CORS origin.
FRONTEND_URL="http://localhost:3000"
# Optional: extra comma-separated origins allowed to call the API (defaults to FRONTEND_URL)
# CORS_ORIGINS="https://notevault.example.com,https://www.notevault.example.com"

# Set to 1 when running behind a proxy/load balancer (Render, Railway, Fly, Nginx) so rate limiting sees real client IPs.
# TRUST_PROXY=1

# Gmail account + App Password (Google Account > Security > App passwords) for invite and reset emails.
# Without these, emails are printed to the console in development.
SMTP_EMAIL=""
SMTP_APP_PASSWORD=""

# Set to false to disable the hourly due-date reminder job (e.g. when running several API instances).
# ENABLE_CRON=true
