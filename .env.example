# Used by docker-compose.yml. Copy to .env and fill in. Never commit .env.
MYSQL_ROOT_PASSWORD=change-me
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5069
# Email: Gmail (SMTP_EMAIL + SMTP_APP_PASSWORD) or any provider (SMTP_HOST/PORT/USER/PASS/FROM). See README > Email.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
